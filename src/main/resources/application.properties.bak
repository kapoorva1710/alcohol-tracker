spring.application.name=alcohol-tracker

# ========== MySQL Database Configuration ==========
spring.datasource.url=jdbc:mysql://localhost:3306/alcohol_tracker?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=Kapoorva@2004
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ========== JPA / Hibernate Configuration ==========
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# ========== IMAP Configuration for Email Scanner ==========
tracker.mail.host=imap.gmail.com
tracker.mail.username=your-email@gmail.com
tracker.mail.password=your-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
